{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/dashboard.js", "use": "@vercel/node" },
    { "src": "(.*)", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/dashboard", "dest": "/api/dashboard.js" },
    { "src": "/api/dashboard.php", "dest": "/api/dashboard.js" },
    { "src": "/dashboard.html", "dest": "/pages/dashboard.html" },
    { "src": "/monitor.html", "dest": "/pages/monitor.html" },
    { "src": "/charts.html", "dest": "/pages/charts.html" },
    { "src": "/history.html", "dest": "/pages/history.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_SECRET_KEY": "@supabase_secret_key"
  }
}
