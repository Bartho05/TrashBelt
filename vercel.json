{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/dashboard.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "css/style.css", "use": "@vercel/static" },
    { "src": "js/app.js", "use": "@vercel/static" },
    { "src": "js/shell.js", "use": "@vercel/static" },
    { "src": "(.*)", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/dashboard", "dest": "/api/dashboard.js" },
    { "src": "/api/dashboard.php", "dest": "/api/dashboard.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_SECRET_KEY": "@supabase_secret_key"
  }
}
