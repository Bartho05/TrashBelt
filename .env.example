# Variáveis de ambiente para o backend Trashbelt (Vercel / servidor)
# Copie este arquivo para .env (local) ou defina nas Environment Variables da Vercel.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_XXXX...
SUPABASE_ANON_KEY=sb_publishable_XXXX...

# Token usado pelo ESP32 no header x-device-token (NUNCA vai no firmware versionado)
TB_DEVICE_TOKEN=SEU_TOKEN_DO_DISPOSITIVO
